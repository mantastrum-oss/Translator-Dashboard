POSTGRES_DB=translator_analytics
POSTGRES_USER=translator
POSTGRES_PASSWORD=translator
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://translator:translator@localhost:5432/translator_analytics
APP_ENV=development
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANALYTICS_API_KEY=change-me
# Dashboard login: the password you type, and a long random secret that signs sessions.
# Changing SESSION_SECRET logs every browser out.
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string
API_PORT=8000
WEB_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Browser-safe values only. Never put SUPABASE_SERVICE_ROLE_KEY in a VITE_* variable.
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
